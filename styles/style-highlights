/* =========================================
   Base & Variables
   ========================================= */
:root {
    --bg-green-light: #f3f9f4;
    --border-card: #e5ebe6;
    --text-primary: #1a2b22;
    --text-secondary: #5e6b63;
    --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

.golf-highlights-wrapper {
    font-family: var(--font-sans);
    color: var(--text-primary);
    max-width: 1200px;
    margin: 0 auto;
    line-height: 1.5;
}

/* =========================================
   Main Green Container
   ========================================= */
.highlights-container {
    background-color: var(--bg-green-light);
    border: 1px solid var(--border-card);
    border-radius: 8px;
    padding: 40px;
    margin-bottom: 20px;
}

.highlights-container h2 {
    font-size: 1.8rem;
    font-weight: 600;
    margin: 0 0 30px 0;
    color: #2c3e32;
}

/* =========================================
   Top Grid: Cards
   ========================================= */
.highlights-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 40px;
}

.hl-card {
    background: #ffffff;
    border: 1px solid var(--border-card);
    border-radius: 8px;
    padding: 25px 20px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 8px rgba(0,0,0,0.02);
}

.hl-icon {
    color: var(--text-primary);
    margin-bottom: 15px;
}

.hl-card h3, .hl-card h4 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 10px 0;
}

.hl-card-content p {
    font-size: 0.9rem;
    margin: 0 0 8px 0;
}

.clean-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.9rem;
}

.clean-list li {
    margin-bottom: 4px;
}

.text-muted {
    color: var(--text-secondary);
}

.mt-auto {
    margin-top: auto;
    padding-top: 15px;
}

.mt-half {
    margin-top: 20px;
}

/* Split Cards (Cards 3 & 4) */
.split-card .card-half {
    display: flex;
    flex-direction: column;
}

.split-card .card-half:not(:first-child) {
    margin-top: 25px;
}

.card-divider {
    border: 0;
    border-top: 1px solid var(--border-card);
    margin: 20px 0;
}

/* =========================================
   Middle Grid: Features
   ========================================= */
.highlights-features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 35px 25px;
    border-top: 1px solid #dce8df;
    padding-top: 35px;
}

.feature-item {
    display: flex;
    gap: 15px;
    align-items: flex-start;
}

.feature-icon svg {
    color: var(--text-primary);
    flex-shrink: 0;
}

.feature-text h4 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 5px 0;
}

.feature-text p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0;
}

/* =========================================
   Bottom Banner
   ========================================= */
.special-packages-banner {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    padding: 20px 5px;
    border-top: 1px solid #ddd;
    font-size: 0.95rem;
}

.special-packages-banner strong {
    white-space: nowrap;
    color: #333;
}

.special-packages-banner p {
    margin: 0;
    color: #444;
}

/* =========================================
   Responsive Adjustments
   ========================================= */
@media (max-width: 1024px) {
    .highlights-cards {
        grid-template-columns: repeat(2, 1fr);
    }
    .highlights-features {
        grid-template-columns: repeat(2, 1fr);
    }
    .special-packages-banner {
        flex-direction: column;
        gap: 5px;
    }
}

@media (max-width: 600px) {
    .highlights-container {
        padding: 25px 15px;
    }
    .highlights-cards {
        grid-template-columns: 1fr;
    }
    .highlights-features {
        grid-template-columns: 1fr;
    }
}